import argparse
import math

from torch import nn
from torchvision import transforms

from training_common import (
    fit,
    get_device,
    make_loaders,
    set_seed,
)


class FullyConnectedClassifier(nn.Module):
    def __init__(
        self,
        input_shape,
        num_classes,
        hidden_sizes,
        activation="relu",
        dropout=0.2,
        batchnorm=False,
    ):
        super().__init__()

        activation_classes = {
            "relu": nn.ReLU,
            "tanh": nn.Tanh,
            "sigmoid": nn.Sigmoid,
        }

        layers = [nn.Flatten()]
        input_features = math.prod(input_shape)

        for hidden_features in hidden_sizes:
            layers.append(
                nn.Linear(input_features, hidden_features)
            )

            if batchnorm:
                layers.append(
                    nn.BatchNorm1d(hidden_features)
                )

            layers.append(
                activation_classes[activation]()
            )

            if dropout > 0:
                layers.append(nn.Dropout(dropout))

            input_features = hidden_features

        layers.append(
            nn.Linear(input_features, num_classes)
        )

        self.network = nn.Sequential(*layers)

    def forward(self, images):
        return self.network(images)


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--dataset",
        choices=["mnist", "cifar10"],
        default="mnist",
    )

    parser.add_argument(
        "--hidden",
        nargs="+",
        type=int,
        default=[512, 256],
    )

    parser.add_argument(
        "--activation",
        choices=["relu", "tanh", "sigmoid"],
        default="relu",
    )

    parser.add_argument("--batchnorm", action="store_true")
    parser.add_argument("--dropout", type=float, default=0.2)
    parser.add_argument("--epochs", type=int, default=10)
    parser.add_argument("--batch-size", type=int, default=128)
    parser.add_argument("--lr", type=float, default=1e-3)
    parser.add_argument("--limit", type=int, default=0)
    parser.add_argument("--data-root", default="./data")
    parser.add_argument("--output", default="outputs/lesson3")

    args = parser.parse_args()
    set_seed(42)

    if args.dataset == "mnist":
        input_shape = (1, 28, 28)
        mean = (0.1307,)
        std = (0.3081,)
    else:
        input_shape = (3, 32, 32)
        mean = (0.4914, 0.4822, 0.4465)
        std = (0.2470, 0.2435, 0.2616)

    transform = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize(mean, std),
    ])

    train_loader, val_loader, test_loader, classes = (
        make_loaders(
            dataset_name=args.dataset,
            root=args.data_root,
            batch_size=args.batch_size,
            train_transform=transform,
            eval_transform=transform,
            limit=args.limit,
        )
    )

    model = FullyConnectedClassifier(
        input_shape=input_shape,
        num_classes=len(classes),
        hidden_sizes=args.hidden,
        activation=args.activation,
        dropout=args.dropout,
        batchnorm=args.batchnorm,
    )

    metadata = {
        "architecture": "fully_connected",
        "dataset": args.dataset,
        "input_shape": list(input_shape),
        "num_classes": len(classes),
        "classes": classes,
        "hidden_sizes": args.hidden,
        "activation": args.activation,
        "dropout": args.dropout,
        "batchnorm": args.batchnorm,
        "mean": list(mean),
        "std": list(std),
    }

    fit(
        model=model,
        train_loader=train_loader,
        val_loader=val_loader,
        test_loader=test_loader,
        device=get_device(),
        epochs=args.epochs,
        lr=args.lr,
        output=args.output,
        metadata=metadata,
    )


if __name__ == "__main__":
    main()
